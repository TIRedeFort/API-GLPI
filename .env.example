APP_NAME=API GLPI
APP_ENV=production
APP_PORT=8000
APP_PUBLIC_PREFIX=/api-glpi

# Protege os endpoints da API. Envie no header X-API-Key.
API_KEY=troque-esta-chave

# API REST legada do GLPI.
GLPI_API_URL=https://fortsupermercados.com.br/suporte/apirest.php
GLPI_APP_TOKEN=cole_o_app_token_aqui
GLPI_USER_TOKEN=cole_o_token_do_usuario_aqui

# Leitura dos formularios nativos do GLPI 11. Use uma conta MySQL/MariaDB
# dedicada, somente leitura, com acesso apenas as tabelas/colunas documentadas.
GLPI_DB_HOST=
GLPI_DB_PORT=3306
GLPI_DB_NAME=
GLPI_DB_USER=
GLPI_DB_PASSWORD=
GLPI_DB_TABLE_PREFIX=glpi_

# Padroes usados ao criar chamados quando o payload nao informar.
GLPI_DEFAULT_ENTITY_ID=4
GLPI_DEFAULT_CATEGORY_ID=287
GLPI_DEFAULT_REQUESTER_ID=114
GLPI_DEFAULT_TICKET_TYPE=1
GLPI_DEFAULT_REQUEST_TYPE_ID=1
GLPI_DEFAULT_URGENCY=3
GLPI_DEFAULT_IMPACT=3
GLPI_DEFAULT_PRIORITY=3
GLPI_DEFAULT_ASSIGN_USER_ID=
GLPI_DEFAULT_ASSIGN_GROUP_ID=

# Se true, fecha a sessao GLPI apos cada operacao.
GLPI_KILL_SESSION=true
